#Область ПрограммныйИнтерфейс

#Область ИнтерфейсПолученияДанных

// Функция получает результат запроса из внешней ИБ через http-сервис IDBData.GetQueryResult
//
// Параметры:
//   НастройкиПодключения         - Структура              - настройки подключения к http-сервису:
//     *Сервис_Сервер               - Строка                 - адрес сервера http-сервиса
//     *Сервис_АдресРесурса         - Строка                 - адрес ресурса http-сервиса
//     *Сервис_Пользователь         - Строка                 - имя пользователя сервиса
//     *Сервис_Пароль               - Строка                 - пароль пользователя сервиса
//     *Соединение                  - HTTPСоединение         - полученный ранее объект соединения
//                                                             с http-сервисом для повторного использования
//     *Соединение_Использование    - Булево                 - флаг необходимости повторного использования
//                                                             объекта соединения с http-сервисом 
//     *Таймаут                     - Число                  - время ожидания соединения
//   Поля                        - Строка                  - список получаемых полей, разделенный ","
//                                 Массив из Строка          или массив имен получаемых полей
//
// Возвращаемое значение:
//   Строка, Массив из Строка - результат выполнения запроса
//
Функция Запросы(НастройкиПодключения, Знач Поля = "") Экспорт

	Если НЕ ЗначениеЗаполнено(Поля) Тогда
		Поля = Новый Массив();
	КонецЕсли;
	Если ТипЗнч(Поля) = Тип("Строка") Тогда
		Поля = СтрРазделить(Поля, ",", Ложь);
	КонецЕсли;
	
	ПараметрыURL = Новый Соответствие();
	Если ТипЗнч(Поля) = Тип("Массив") Тогда
		Для й = 0 По Поля.ВГраница() Цикл
			Поля[й] = СокрЛП(Поля[й]);
		КонецЦикла;
		ПараметрыURL.Вставить("fields", СтрСоединить(Поля, ","));
	КонецЕсли;

	АдресСервиса = СтрШаблон("%1%2/GetQueriesList",
	                         НастройкиПодключения.Сервис_Сервер,
	                         НастройкиПодключения.Сервис_АдресРесурса);

	ДопПараметры = ПараметрыHTTPЗапроса(НастройкиПодключения);
	
	Попытка
		ОтветСервиса = бир_КоннекторHTTP.Get(АдресСервиса, ПараметрыURL, ДопПараметры);
	Исключение
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ТекстОшибки = СтрШаблон("Ошибка получения списка запросов в сервисе ""%1"":%2%3",
		                        АдресСервиса,
		                        Символы.ПС,
		                        ТекстОшибки);
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;

	Если НЕ ОтветСервиса.КодСостояния = бир_ВнешниеИБОбработкаЗапросов.КодыСостояния().Успешно_200 Тогда
		ТекстОшибки = ПолучитьСтрокуИзДвоичныхДанных(ОтветСервиса.Тело);
		ТекстОшибки = СтрШаблон("Ошибка получения списка запросов в сервисе ""%1"", код состояния (%2):%3%4",
		                        АдресСервиса,
		                        ОтветСервиса.КодСостояния,
		                        Символы.ПС,
		                        ТекстОшибки);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;

	Попытка
		ДанныеОтвета = бир_КоннекторHTTP.КакJson(ОтветСервиса, ДопПараметры.ПараметрыПреобразованияJSON);
	Исключение
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ТекстОшибки = СтрШаблон("Ошибка получения списка запросов в сервисе ""%1"":%2%3",
		                        АдресСервиса,
		                        Символы.ПС,
		                        ТекстОшибки);
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;

	Возврат ПреобразованиеДанных().ЗначениеИзСтруктуры(ДанныеОтвета);

КонецФункции // Запросы()


// Функция - Проверяет наличие функциональности дополнительных реквизитов и сведений
//
// Параметры:
//   ИдентификаторОбъекта    - СправочникСсылка.                   - Объект для которого проверяется наличие доолнительных реквизитов
//                             ИдентификаторыОбъектовМетаданных,     если не указан, то возвращается наличие функциональности
//                             СправочникСсылка.                     доп. реквизитов для конфигурации в целом
//                             ИдентификаторыОбъектовРасширений
//																				  
//   ДопРеквизиты            - Массив (ПланВидовХарактеристикСсылка.		- В параметре возвращается массив доп реквизитов
//                             ДополнительныеРеквизитыИСведения)
// 
// Возвращаемое значение:
//   Булево - Истина - Есть функциональностть доп. реквизитов
//
Функция ЕстьДопРеквизиты(ИдентификаторОбъекта = Неопределено, ДопРеквизиты = Неопределено) Экспорт
	
	Если Метаданные.Справочники.Найти("НаборыДополнительныхРеквизитовИСведений") = Неопределено
	 ИЛИ Метаданные.ПланыВидовХарактеристик.Найти("ДополнительныеРеквизитыИСведения") = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
		
	Если ИдентификаторОбъекта = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	МетаОбъект = Метаданные.НайтиПоПолномуИмени(ИдентификаторОбъекта.ПолноеИмя);
	
	Если МетаОбъект = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НаборДопРеквизитов = Неопределено;
	Попытка
		НаборДопРеквизитов = Справочники.НаборыДополнительныхРеквизитовИСведений[СтрЗаменить(ИдентификаторОбъекта.ПолноеИмя, ".", "_")]
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	Если НаборДопРеквизитов = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МассивНазначений = Новый Массив();
		
	Если НаборДопРеквизитов.ЭтоГруппа Тогда
		Выборка = Справочники.НаборыДополнительныхРеквизитовИСведений.Выбрать(НаборДопРеквизитов);
		
		Пока Выборка.Следующий() Цикл
			Если Выборка.ЭтоГруппа Тогда
				Продолжить;
			КонецЕсли;
			МассивНазначений.Добавить(Выборка.Ссылка);
		КонецЦикла;
	Иначе
		МассивНазначений.Добавить(НаборДопРеквизитов);
	КонецЕсли;
	
	ДопРеквизиты = Новый Массив();
	Для Каждого ТекНазначение Из МассивНазначений Цикл
		
		Для Каждого ТекСтрока Из ТекНазначение.ДополнительныеРеквизиты Цикл
			Если НЕ ДопРеквизиты.Найти(ТекСтрока.Свойство) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ДопРеквизиты.Добавить(ТекСтрока.Свойство);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если МетаОбъект.ТабличныеЧасти.Найти("ДополнительныеРеквизиты") = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;

КонецФункции // ЕстьДопРеквизиты()

// Функция - Получает список измененных реквизитов объекта
//
// Параметры:
//  Источник			 - Объект, НаборЗаписей			 - Объект - источник возникновения события
// 
// Возвращаемое значение:
//  Структура - Список измененных реквизитов объекта
//
Функция ИзмененныеРеквизиты(Источник, НастройкаОбработкиОбъекта)
	
	МетаОбъект = Источник.Метаданные();
	
	ИдентификаторОбъекта = Справочники.ИдентификаторыОбъектовМетаданных.НайтиПоРеквизиту("ПолноеИмя", МетаОбъект.ПолноеИмя());
	Если НЕ ЗначениеЗаполнено(ИдентификаторОбъекта) Тогда
		ИдентификаторОбъекта = Справочники.ИдентификаторыОбъектовРасширений.НайтиПоРеквизиту("ПолноеИмя", МетаОбъект.ПолноеИмя());
	КонецЕсли;
	
	ПроверяемыеРеквизиты = НастройкаОбработкиОбъекта.ПроверяемыеРеквизиты;
	ИсключаемыеРеквизиты = НастройкаОбработкиОбъекта.ИсключаемыеРеквизиты;
	
	СохраненныйДокумент = Источник.Ссылка;
	
	ИзмененныеРеквизиты = Новый Соответствие();
	
	Если НЕ ОбъектСоответствуетОтбору(Источник, НастройкаОбработкиОбъекта) Тогда
		Возврат ИзмененныеРеквизиты;
	КонецЕсли;

	Для Каждого ТекРеквизит Из МетаОбъект.СтандартныеРеквизиты Цикл
		Если НЕ ИсключаемыеРеквизиты.Найти(ТекРеквизит.Имя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если (НЕ ПроверяемыеРеквизиты.Количество() = 0) И ПроверяемыеРеквизиты.Найти(ТекРеквизит.Имя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если Источник[ТекРеквизит.Имя] = СохраненныйДокумент[ТекРеквизит.Имя] Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначенияРеквизита = ЗначенияИзмененногоРеквизита(СохраненныйДокумент[ТекРеквизит.Имя], Источник[ТекРеквизит.Имя]);

		ИзмененныеРеквизиты.Вставить(ТекРеквизит.Имя, ЗначенияРеквизита);
		
	КонецЦикла;
	
	Для Каждого ТекРеквизит Из МетаОбъект.Реквизиты Цикл
		Если НЕ ИсключаемыеРеквизиты.Найти(ТекРеквизит.Имя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если (НЕ ПроверяемыеРеквизиты.Количество() = 0) И ПроверяемыеРеквизиты.Найти(ТекРеквизит.Имя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если Источник[ТекРеквизит.Имя] = СохраненныйДокумент[ТекРеквизит.Имя] Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначенияРеквизита = ЗначенияИзмененногоРеквизита(СохраненныйДокумент[ТекРеквизит.Имя], Источник[ТекРеквизит.Имя]);
		
		ИзмененныеРеквизиты.Вставить(ТекРеквизит.Имя, ЗначенияРеквизита);
		
	КонецЦикла;
	
	ДопРеквизиты = Новый Массив();
	
	ЕстьДопРеквизиты = ЕстьДопРеквизиты(ИдентификаторОбъекта, ДопРеквизиты);
	
	Для Каждого ТекТЧ Из МетаОбъект.ТабличныеЧасти Цикл
		
		Если ЕстьДопРеквизиты И ТекТЧ.Имя = "ДополнительныеРеквизиты" Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ИсключаемыеРеквизиты.Найти(СтрШаблон("__ТЧ.%1", ТекТЧ.Имя)) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		КоличествоСтрок = Макс(СохраненныйДокумент[ТекТЧ.Имя].Количество(), Источник[ТекТЧ.Имя].Количество());
		
		Для й = 0 По КоличествоСтрок - 1 Цикл
			
			Если й + 1 > СохраненныйДокумент[ТекТЧ.Имя].Количество() Тогда
				ЗначенияРеквизита = ЗначенияИзмененногоРеквизита("<>", "<строка добавлена>");
				ИзмененныеРеквизиты.Вставить(СтрШаблон("__ТЧ_%1_%2", ТекТЧ.Имя, Формат(й + 1, "ЧГ=0")), ЗначенияРеквизита);
				Продолжить;
			ИначеЕсли й + 1 > Источник[ТекТЧ.Имя].Количество() Тогда
				ЗначенияРеквизита = ЗначенияИзмененногоРеквизита("<строка удалена>", "<>");
				ИзмененныеРеквизиты.Вставить(СтрШаблон("__ТЧ_%1_%2", ТекТЧ.Имя, Формат(й + 1, "ЧГ=0")), ЗначенияРеквизита);
				Продолжить;
			КонецЕсли;
					
			Для Каждого ТекРеквизит Из ТекТЧ.Реквизиты Цикл
				
				Если НЕ ИсключаемыеРеквизиты.Найти(ТекТЧ.Имя + "." + ТекРеквизит.Имя) = Неопределено Тогда
					Продолжить;
				КонецЕсли;
		
				Если (НЕ ПроверяемыеРеквизиты.Количество() = 0)
				   И ПроверяемыеРеквизиты.Найти(СтрШаблон("__ТЧ.%1", ТекТЧ.Имя)) = Неопределено
				   И ПроверяемыеРеквизиты.Найти(СтрШаблон("%1.%2", ТекТЧ.Имя, ТекРеквизит.Имя)) = Неопределено Тогда
					Продолжить;
				КонецЕсли;
		
				Если Источник[ТекТЧ.Имя][й][ТекРеквизит.Имя] = СохраненныйДокумент[ТекТЧ.Имя][й][ТекРеквизит.Имя] Тогда
					Продолжить;
				КонецЕсли;
				
				ЗначенияРеквизита = ЗначенияИзмененногоРеквизита(СохраненныйДокумент[ТекТЧ.Имя][й][ТекРеквизит.Имя],
				                                                 Источник[ТекТЧ.Имя][й][ТекРеквизит.Имя]);
				
				ИзмененныеРеквизиты.Вставить(СтрШаблон("__ТЧ_%1_%2_%3", ТекТЧ.Имя, Формат(й + 1, "ЧГ=0"), ТекРеквизит.Имя),
				                             ЗначенияРеквизита);
				
			КонецЦикла;
		КонецЦикла;
		
	КонецЦикла;
	
	Для Каждого ТекРеквизит Из ДопРеквизиты Цикл
		Если НЕ ИсключаемыеРеквизиты.Найти(СокрЛП(ТекРеквизит.УникальныйИдентификатор())) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если (НЕ ПроверяемыеРеквизиты.Количество() = 0) И ПроверяемыеРеквизиты.Найти(СокрЛП(ТекРеквизит.УникальныйИдентификатор())) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтароеЗначение = Неопределено;
		НовоеЗначение = Неопределено;
		
		СтрокиЗначений = СохраненныйДокумент.ДополнительныеРеквизиты.НайтиСтроки(Новый Структура("Свойство", ТекРеквизит));
		Если СтрокиЗначений.Количество() > 0 Тогда
			СтароеЗначение = СтрокиЗначений[0].Значение;
		КонецЕсли;
		
		СтрокиЗначений = Источник.ДополнительныеРеквизиты.НайтиСтроки(Новый Структура("Свойство", ТекРеквизит));
		Если СтрокиЗначений.Количество() > 0 Тогда
			НовоеЗначение = СтрокиЗначений[0].Значение;
		КонецЕсли;
		
		Если НовоеЗначение = СтароеЗначение Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначенияРеквизита = ЗначенияИзмененногоРеквизита(СтароеЗначение, НовоеЗначение);
		
		ИзмененныеРеквизиты.Вставить(ТекРеквизит, ЗначенияРеквизита);
		
	КонецЦикла;
	
	Возврат ИзмененныеРеквизиты;
	
КонецФункции // ИзмененныеРеквизиты()

Функция ЗначенияИзмененногоРеквизита(СтароеЗначение, НовоеЗначение, ВСтроку = Истина)
	
	ЗначенияРеквизита = Новый Структура();
	ЗначенияРеквизита.Вставить("СтароеЗначение", СтароеЗначение);
	ЗначенияРеквизита.Вставить("НовоеЗначение" , НовоеЗначение);
	
	Если ВСтроку Тогда
		ЗначенияРеквизита.СтароеЗначение = СокрЛП(ЗначенияРеквизита.СтароеЗначение);
		ЗначенияРеквизита.НовоеЗначение  = СокрЛП(ЗначенияРеквизита.НовоеЗначение);
	КонецЕсли;
	
КонецФункции // ЗначенияИзмененногоРеквизита()

Функция ОбъектСоответствуетОтбору(Источник, ПараметрыОбъекта)
	
	Если НЕ (ПараметрыОбъекта.Свойство("НастройкиКомпоновки")
	   И ТипЗнч(ПараметрыОбъекта.НастройкиКомпоновки) = Тип("Структура")) Тогда
		Возврат Истина;
	КонецЕсли;
	
	МетаОбъект = Источник.Метаданные();

	ПоляОтбора = Новый Массив();
	
	Для Каждого ТекРеквизит Из МетаОбъект.Реквизиты Цикл
		ПоляОтбора.Добавить(СтрШаблон("Данные.%1.*", ТекРеквизит.Имя));	
	КонецЦикла;
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	Данные.Ссылка КАК Ссылка
	               |ИЗ
	               |	&ТаблицаОбъекта КАК Данные
				   |ГДЕ
				   |	Данные.Ссылка = &Ссылка
	               |{ГДЕ
	               |	&ПоляОтбора}";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТаблицаОбъекта", МетаОбъект.ПолноеИмя());
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПоляОтбора", СтрСоединить(ПоляОтбора, ","));
	
	СпрЗапрос = Справочники.бир_ЗапросыКДанным.СоздатьЭлемент();
	СпрЗапрос.Ид = "Данные";
	СпрЗапрос.УстановитьТекстЗапроса(ТекстЗапроса);
	
	УстановитьПривилегированныйРежим(Истина);
	
	СКД = СпрЗапрос.СхемаКомпоновкиДанных();
	АдресСКД = ПоместитьВоВременноеХранилище(СКД);
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных();
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСКД));

	НастройкиКомпоновки = Новый НастройкиКомпоновкиДанных();
	ПреобразованиеДанных().НастройкиСКДИзСтруктуры(НастройкиКомпоновки, ПараметрыОбъекта.НастройкиКомпоновки);
	КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиКомпоновки);
	НастройкиКомпоновки = КомпоновщикНастроек.ПолучитьНастройки();
	НастройкиКомпоновки.ПараметрыДанных.УстановитьЗначениеПараметра("Ссылка", Источник.Ссылка);

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СКД,
	                                              НастройкиКомпоновки,
	                                              ,
	                                              ,
	                                              Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
	
	РезультатОтбора = Новый ТаблицаЗначений();
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений();
	ПроцессорВывода.УстановитьОбъект(РезультатОтбора);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);

	Если РезультатОтбора.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции // ОбъектСоответствуетОтбору()

Функция НастройкаОбработкиОбъекта(Знач ИдентификаторОбъекта, Знач Событие)
	
	Настройка = Новый Структура();
	Настройка.Вставить("ПередатьДляОбработки", Ложь);
	Настройка.Вставить("ПроверяемыеРеквизиты", Новый Массив());
	Настройка.Вставить("ИсключаемыеРеквизиты", Новый Массив());
	Настройка.Вставить("НастройкиКомпоновки", Неопределено);
	Настройка.Вставить("СохраняемыеРеквизиты", Новый Массив());
	Настройка.Вставить("НеСохраняемыеРеквизиты", Новый Массив());
	
	СохраненнаяНастройка = Событие.ОбработкаНастройки.Получить();
	
	НастройкиРеквизитов = Новый Соответствие();
	Если СохраненнаяНастройка.Свойство("РеквизитыОбъектов") Тогда
		НастройкиРеквизитов = СохраненнаяНастройка.РеквизитыОбъектов;
	КонецЕсли;
	
	Если НЕ (ТипЗнч(ИдентификаторОбъекта) = Тип("СправочникСсылка.ИдентификаторыОбъектовМетаданных")
	     ИЛИ ТипЗнч(ИдентификаторОбъекта) = Тип("СправочникСсылка.ИдентификаторыОбъектовРасширений")) Тогда
		МетаОбъект = ИдентификаторОбъекта.Метаданные();
		ИдентификаторОбъекта = Справочники.ИдентификаторыОбъектовМетаданных.НайтиПоРеквизиту("ПолноеИмя", МетаОбъект.ПолноеИмя());
		Если НЕ ЗначениеЗаполнено(ИдентификаторОбъекта) Тогда
			ИдентификаторОбъекта = Справочники.ИдентификаторыОбъектовРасширений.НайтиПоРеквизиту("ПолноеИмя", МетаОбъект.ПолноеИмя());
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(НастройкиРеквизитов) = Тип("Соответствие") Тогда
		
		ПараметрыОбъекта = НастройкиРеквизитов[ИдентификаторОбъекта];
		ЗаполнитьЗначенияСвойств(Настройка, ПараметрыОбъекта);
		
	КонецЕсли;
	
	Возврат Настройка;
	
КонецФункции // НастройкаОбработкиОбъекта()

Процедура УстановитьПараметрСобытия(Источник, Событие, Параметр, Значение)
	
	Если Источник.ДополнительныеСвойства.Свойство("бир_События_Параметры") Тогда
		ПараметрыСобытий = Источник.ДополнительныеСвойства.бир_События_Параметры;
	Иначе
		ПараметрыСобытий = Новый Соответствие();
	КонецЕсли;
	
	ПараметрыСобытия = ПараметрыСобытий.Получить(Событие);
	
	Если НЕ ТипЗнч(ПараметрыСобытия) = Тип("Структура") Тогда
		ПараметрыСобытия = Новый Структура();
	КонецЕСли;
	
	ПараметрыСобытия.Вставить(Параметр, Значение);

	ПараметрыСобытий.Вставить(Событие, ПараметрыСобытия);

	Источник.ДополнительныеСвойства.Вставить("бир_События_Параметры", ПараметрыСобытий);

КонецПроцедуры // УстановитьПараметрСобытия()

Функция ЗначениеПараметраСобытия(Источник, Событие, Параметр, ЗначениеПоУмолчанию = Неопределено)
	
	ПараметрыСобытий = Новый Соответствие();
	Если Источник.ДополнительныеСвойства.Свойство("бир_События_Параметры") Тогда
		ПараметрыСобытий = Источник.ДополнительныеСвойства.бир_События_Параметры;
	Иначе
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	ПараметрыСобытия = ПараметрыСобытий.Получить(Событие);

	Если НЕ ТипЗнч(ПараметрыСобытия) = Тип("Структура") Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕСли;

	Если НЕ ПараметрыСобытия.Свойство(Параметр) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат ПараметрыСобытия[Параметр];
	
КонецФункции // ЗначениеПараметраСобытия()

Функция ПреобразованиеДанных()
	
	Если ПреобразованиеДанных = Неопределено Тогда 
		ПреобразованиеДанных = Обработки.бир_ПреобразованиеДанных.Создать();
	КонецЕсли;
	
	Возврат ПреобразованиеДанных;
	
КонецФункции // ПреобразованиеДанных()

#КонецОбласти // СлужебныеПроцедуры

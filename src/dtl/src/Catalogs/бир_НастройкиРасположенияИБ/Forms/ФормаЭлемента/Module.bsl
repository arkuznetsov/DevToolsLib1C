&НаКлиенте
Процедура ОтобразитьЦветаГлавногоСтиля()
	
	Элементы.ДекорацияЦветАктивности.ЦветФона              = Новый Цвет();
	Элементы.ДекорацияЦветАкцентирования.ЦветФона          = Новый Цвет();
	Элементы.ДекорацияЦветНавигации.ЦветФона               = Новый Цвет();
	Элементы.ДекорацияЦветНавигацииДополнительный.ЦветФона = Новый Цвет();
	Элементы.ДекорацияЦветВажного.ЦветФона                 = Новый Цвет();
	
	Если ПустаяСтрока(Объект.ГлавныйСтиль) ИЛИ НЕ Стили.Свойство(Объект.ГлавныйСтиль) Тогда
		Возврат;
	КонецЕсли;
	
	ВремЦвета = Стили[Объект.ГлавныйСтиль];
	
	Элементы.ДекорацияЦветАктивности.ЦветФона              = ВремЦвета.ЦветАктивности;
	Элементы.ДекорацияЦветАкцентирования.ЦветФона          = ВремЦвета.ЦветАкцентирования;
	Элементы.ДекорацияЦветНавигации.ЦветФона               = ВремЦвета.ЦветНавигации;
	Элементы.ДекорацияЦветНавигацииДополнительный.ЦветФона = ВремЦвета.ЦветНавигацииДополнительный;
	Элементы.ДекорацияЦветВажного.ЦветФона                 = ВремЦвета.ЦветВажного;

КонецПроцедуры // ОтобразитьЦветаГлавногоСтиля()


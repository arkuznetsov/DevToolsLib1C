
#Область ПрограммныйИнтерфейс

// Функция - возвращает описание текущего расположения информационной базы
//
// Возвращаемое значение:
//   СправочникСсылка.бир_РасположенияИБ    - текущее расположение информационной базы
//
Функция ТекущееРасположениеИБ() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	Возврат ПараметрыСеанса.бир_ТекущееРасположениеИБ;
	
КонецФункции // ТекущееРасположениеИБ()

// Функция - возвращает описание последнего сохраненного расположения информационной базы
//
// Возвращаемое значение:
//   СправочникСсылка.бир_РасположенияИБ    - текущее расположение информационной базы
//
Функция ПоследнееРасположениеИБ() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	Возврат Константы.бир_ПоследнееРасположениеИБ.Получить();
	
КонецФункции // ПоследнееРасположениеИБ()

// Процедура - устанавливает текущее расположения информационной базы
//
// Параметры:
//   ТекущееРасположение    - СправочникСсылка.бир_РасположенияИБ    - текущее расположение информационной базы
//
Процедура ОбновитьТекущееРасположениеИБ(Знач ТекущееРасположение) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);

	Константы.бир_ПоследнееРасположениеИБ.Установить(ТекущееРасположение);
	ПараметрыСеанса.бир_ТекущееРасположениеИБ = ТекущееРасположение;

	Если ТекущееРасположение.Пустая() Тогда
		ТекущееРасположение = Справочники.бир_РасположенияИБ.ПоУмолчанию;
	КонецЕсли;
		
	ОбработатьПользователей(ТекущееРасположение.НастройкаРасположения);
	
	ОбработатьРасширения(ТекущееРасположение.НастройкаРасположения);

	ОбработатьРегламентныеЗадания(ТекущееРасположение.НастройкаРасположения);

	ВыполнитьОбновлениеНумерацииОбъектов(ТекущееРасположение.НастройкаРасположения);

	ОбработатьПроизвольныйКод(ТекущееРасположение.НастройкаРасположения);

КонецПроцедуры // ОбновитьТекущееРасположениеИБ()

// Процедура - обновляет текущее расположение ИБ и устанавливает главный стиль приложения
//
Процедура УстановкаПараметровСеанса(ИмяПараметра, УстановленныеПараметры) Экспорт
	
	Если ИмяПараметра = "бир_ТекущееРасположениеИБ" Тогда
		ПараметрыСеанса.бир_ТекущееРасположениеИБ = НовоеРасположениеИБ();
		УстановленныеПараметры.Добавить("бир_ТекущееРасположениеИБ");
	КонецЕсли;

	Если НЕ ПоследнееРасположениеИБ() = ТекущееРасположениеИБ() Тогда
		ОбновитьТекущееРасположениеИБ(ТекущееРасположениеИБ());
	КонецЕсли;

	УстановитьГлавныйСтиль(ТекущееРасположениеИБ());
	
КонецПроцедуры // УстановкаПараметровСеанса()

// Функция - проверяет необходимость вывода сообщения пользователю при смене расположения ИБ
//
// Параметры:
//   ТекстСообщения    - Строка    - (возвр.) текст сообщения пользователю
//
// Возвращаемое значение:
//   Булево    - Истина - требуется выводить сообщение пользователю
//
Функция ВыводитьСообщениеПользователюОТекущемРасположенииИБ(ТекстСообщения = "") Экспорт
	
	УстановитьПривилегированныйРежим(Истина);

	ТекущееРасположение = ТекущееРасположениеИБ();
	Если ТекущееРасположение.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Результат = Ложь;
	
	Если ТекущееРасположение.ВыводитьСообщениеПользователю Тогда
		ТекстСообщения = ТекущееРасположение.ТекстСообщенияПользователю;
		Результат = Истина;
	ИначеЕсли ТекущееРасположение.НастройкаРасположения.ВыводитьСообщениеПользователю Тогда
		ТекстСообщения = ТекущееРасположение.НастройкаРасположения.ТекстСообщенияПользователю;
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ВыводитьСообщениеПользователюОТекущемРасположенииИБ()

// Функция - проверяет необходимость изменения заголовка главного окна
//
// Параметры:
//   Заголовок    - Строка    - (возвр.) текст заголовка главного окна
//
// Возвращаемое значение:
//   Булево    - Истина - требуется установить текст заголовка главного окна
//
Функция УстанавливатьЗаголовокСистемы(Заголовок = "") Экспорт
	
	ТекущееРасположение = ТекущееРасположениеИБ();
    Если ТекущееРасположение.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Результат = Ложь;
	
	Если ТекущееРасположение.УстановитьЗаголовокСистемы Тогда
		Заголовок = ТекущееРасположение.ЗаголовокСистемы;
		Результат = Истина;
	ИначеЕсли ТекущееРасположение.НастройкаРасположения.УстановитьЗаголовокСистемы Тогда
		Заголовок = ТекущееРасположение.НастройкаРасположения.ЗаголовокСистемы;
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // УстанавливатьЗаголовокСистемы()

// Функция - возвращает версию системы
//
// Возвращаемое значение:
//   Строка    - версия системы
//
Функция ВерсияСистемы() Экспорт
	
	Возврат бир_ОбновлениеИнформационнойБазы.ВерсияБиблиотеки();
	
КонецФункции // ВерсияСистемы()

#КонецОбласти


    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.ТочкаВозникновения</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ЖурналСобытий.ТочкаВозникновения КАК ТочкаВозникновения,
	ЖурналСобытий.Ид КАК Ид,
	ЖурналСобытий.Источник КАК Источник,
	ДОБАВИТЬКДАТЕ(ЖурналСобытий.Дата, МИНУТА, &amp;СмещениеВремени) КАК Дата,
	ЖурналСобытий.Момент КАК Момент,
	ЖурналСобытий.Событие КАК Событие,
	ЖурналСобытий.ТипИсточника КАК ТипИсточника,
	ЖурналСобытий.Пользователь КАК Пользователь,
	ЖурналСобытий.Параметры КАК Параметры,
	ЖурналСобытий.Ошибка КАК Ошибка,
	ЖурналСобытий.РезультатПроверки КАК РезультатПроверки,
	СобытияОбработка.РучнаяОбработка КАК РучнаяОбработка,
	СобытияОбработка.Обработано КАК Обработано,
	СобытияОбработка.Ошибка КАК ОшибкаОбработки,
	ЖурналСобытий.Событие.ВремяЖизни КАК ВремяЖизни
ИЗ
	РегистрСведений.бир_События КАК ЖурналСобытий
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			СобытияОбработка.ТочкаВозникновения КАК ТочкаВозникновения,
			СобытияОбработка.Ид КАК Ид,
			МАКСИМУМ(СобытияОбработка.РучнаяОбработка) КАК РучнаяОбработка,
			МИНИМУМ(СобытияОбработка.Обработано) КАК Обработано,
			МАКСИМУМ(СобытияОбработка.Ошибка) КАК Ошибка
		ИЗ
			(ВЫБРАТЬ
				СобытияОбработка.ТочкаВозникновения КАК ТочкаВозникновения,
				СобытияОбработка.Ид КАК Ид,
				СобытияОбработка.РучнаяОбработка КАК РучнаяОбработка,
				СобытияОбработка.Обработано КАК Обработано,
				СобытияОбработка.Ошибка КАК Ошибка
			ИЗ
				РегистрСведений.бир_СобытияОбработка КАК СобытияОбработка
			
			ОБЪЕДИНИТЬ
			
			ВЫБРАТЬ
				СобытияОбработка.ТочкаВозникновения,
				СобытияОбработка.Ид,
				ЛОЖЬ,
				СобытияОбработка.Обработано,
				СобытияОбработка.Ошибка
			ИЗ
				РегистрСведений.бир_СобытияОбработкаНаКлиенте КАК СобытияОбработка) КАК СобытияОбработка
		
		СГРУППИРОВАТЬ ПО
			СобытияОбработка.ТочкаВозникновения,
			СобытияОбработка.Ид) КАК СобытияОбработка
		ПО ЖурналСобытий.ТочкаВозникновения = СобытияОбработка.ТочкаВозникновения
			И ЖурналСобытий.Ид = СобытияОбработка.Ид</queryText>
      <mainTable>InformationRegister.бир_События</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>

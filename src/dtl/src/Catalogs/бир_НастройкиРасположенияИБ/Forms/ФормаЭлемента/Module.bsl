#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьПроизвольныйКод(Команда)
	
	ТекущаяСтрока = Элементы.ПроизвольныйКодПриСменеРасположения.ТекущиеДанные;
	
	Если НЕ ТекущаяСтрока = Неопределено Тогда
		Элементы.ПроизвольныйКодПриСменеРасположения.ТекущиеДанные.Код = ПолеПроизвольныйКод;
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры // ЗаписатьПроизвольныйКод()

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьСписокРегламентныхЗаданий()
	
	МассивЗаданий = РегламентныеЗадания.ПолучитьРегламентныеЗадания();
	ИменаЗаданий = Новый Массив();
	Для Каждого ТекЗадание Из МассивЗаданий Цикл
		ИменаЗаданий.Добавить(ТекЗадание.Метаданные.Имя);
	КонецЦикла;

	ТабЗаданий = РеквизитФормыВЗначение("НастройкаРегламентныхЗаданий");
	ТабЗаданий.Очистить();
	Для Каждого ТекСтрока Из Объект.НастройкаРегламентныхЗаданий Цикл
		Если ИменаЗаданий.Найти(ТекСтрока.Задание) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = ТабЗаданий.Добавить();
		НоваяСтрока.Имя      = ТекСтрока.Задание;
		НоваяСтрока.Действие = ?(ТекСтрока.Действие, 1, 0);
	КонецЦикла;
	
	Для Каждого ТекЗадание Из МассивЗаданий Цикл
		ДобавленныеСтроки = ТабЗаданий.НайтиСтроки(Новый Структура("Имя", ТекЗадание.Метаданные.Имя));
		Если ДобавленныеСтроки.Количество() > 0 Тогда
			ДобавленныеСтроки[0].Представление = ТекЗадание.Метаданные.Представление(); 
			Продолжить;
		КонецЕсли;
		НоваяСтрока = ТабЗаданий.Добавить();
		НоваяСтрока.Имя           = ТекЗадание.Метаданные.Имя;
		НоваяСтрока.Представление = ТекЗадание.Метаданные.Представление();
		НоваяСтрока.Действие      = 2;
	КонецЦикла;
	
	ТабЗаданий.Сортировать("Представление");
	
	ЗначениеВРеквизитФормы(ТабЗаданий, "НастройкаРегламентныхЗаданий");
	
КонецПроцедуры // ОбновитьСписокРегламентныхЗаданий()

&НаСервере
Процедура ОбновитьРасширений()
	
	МассивРасширений = РасширенияКонфигурации.Получить(, ИсточникРасширенийКонфигурации.БазаДанных);
	ИменаРасширений = Новый Массив();
	Для Каждого ТекРасширение Из МассивРасширений Цикл
		ИменаРасширений.Добавить(ТекРасширение.Имя);
	КонецЦикла;

	ТабРасширений = РеквизитФормыВЗначение("НастройкаРасширений");
	ТабРасширений.Очистить();
	Для Каждого ТекСтрока Из Объект.НастройкаРасширений Цикл
		Если ИменаРасширений.Найти(ТекСтрока.Расширение) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = ТабРасширений.Добавить();
		НоваяСтрока.Имя                     = ТекСтрока.Расширение;
		НоваяСтрока.Активность              = ?(ТекСтрока.Активность, 1, 0);
		НоваяСтрока.БезопасныйРежим         = ?(ТекСтрока.БезопасныйРежим, 1, 0);
		НоваяСтрока.ЗащитаОтОпасныхДействий = ?(ТекСтрока.ЗащитаОтОпасныхДействий, 1, 0);
	КонецЦикла;
	
	Для Каждого ТекРасширение Из МассивРасширений Цикл
		ДобавленныеСтроки = ТабРасширений.НайтиСтроки(Новый Структура("Имя", ТекРасширение.Имя));
		Если ДобавленныеСтроки.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = ТабРасширений.Добавить();
		НоваяСтрока.Имя                     = ТекРасширение.Имя;
		НоваяСтрока.Активность              = 2;
		НоваяСтрока.БезопасныйРежим         = 2;
		НоваяСтрока.ЗащитаОтОпасныхДействий = 2;
	КонецЦикла;
	
	ТабРасширений.Сортировать("Имя");
	
	ЗначениеВРеквизитФормы(ТабРасширений, "НастройкаРасширений");
	
КонецПроцедуры // ОбновитьСписокРегламентныхЗаданий()

&НаСервере
Процедура ЗаполнитьСписокСтилей()
	
	Элементы.ГлавныйСтиль.СписокВыбора.Добавить("ОСНОВНОЙ", "Основной");
	
	Для Каждого ТекСтиль Из Метаданные.Стили Цикл
		Элементы.ГлавныйСтиль.СписокВыбора.Добавить(ТекСтиль.Имя, ТекСтиль.Представление());
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьСписокСтилей()


#Область СлужебныйПрограммныйИнтерфейс

// Функция - проверяет наличие недопустимых символов в идентификаторе
//
// Параметры:
//   Идентификатор          - Строка               - проверяемый идентификатор (разделеный ".")
//   НедопустимыеСимволы    - Массив из Структура  - (возвр.) массив недопустимых символов с указанием расположения
//     *Символ                - Строка               - недопустимый символ
//     *Начальный             - Булево               - недопустимый символ является начальным
//     *ЧастьИд               - Число                - номер части идентификатора
//     *Позиция               - Число                - позиция недопустимого символа в части идентификатора (ЧастьИд)
//     *ПозицияАбс            - Число                - позиция недопустимого символа от начала идентификатора
// 
// Возвращаемое значение:
//   Булево               - Истина - идентификатор не содержит недопустимых символов
//                          Ложь - в противном случае
//
Функция ИдентификаторЗапросаВалиден(Знач Идентификатор, НедопустимыеСимволы = Неопределено) Экспорт
	
	ДопустимыеСимволы = ДопустимыеСимволы();
	ДопустимыеНачальныеСимволы = ДопустимыеНачальныеСимволы();
	
	ЧастиИдентификатора = СтрРазделить(Идентификатор, ".");
	
	НедопустимыеСимволы = Новый Массив();
	
	ПозицияНачалаАбс = 0;
	
	Для й = 0 По ЧастиИдентификатора.ВГраница() Цикл
		
		ТекЧасть = ЧастиИдентификатора[й];
		
		Для к = 1 По СтрДлина(ТекЧасть) Цикл
			ТекСимвол = Сред(ТекЧасть, к, 1);
			Если ДопустимыеСимволы.Получить(ТекСимвол) = Неопределено Тогда
				НедопустимыйСимвол = Новый Структура();
				НедопустимыйСимвол.Вставить("Символ"    , ТекСимвол);
				НедопустимыйСимвол.Вставить("Начальный" , Ложь);
				НедопустимыйСимвол.Вставить("ЧастьИд"   , й + 1);
				НедопустимыйСимвол.Вставить("Позиция"   , к);
				НедопустимыйСимвол.Вставить("ПозицияАбс", ПозицияНачалаАбс + к);
				
				НедопустимыеСимволы.Добавить(НедопустимыйСимвол);
			ИначеЕсли к = 1 И ДопустимыеНачальныеСимволы.Получить(ТекСимвол) = Неопределено Тогда
				НедопустимыйСимвол = Новый Структура();
				НедопустимыйСимвол.Вставить("Символ"    , ТекСимвол);
				НедопустимыйСимвол.Вставить("Начальный" , Истина);
				НедопустимыйСимвол.Вставить("ЧастьИд"   , й + 1);
				НедопустимыйСимвол.Вставить("Позиция"   , к);
				НедопустимыйСимвол.Вставить("ПозицияАбс", ПозицияНачалаАбс + к);
				
				НедопустимыеСимволы.Добавить(НедопустимыйСимвол);
			КонецЕсли;
		КонецЦикла;
		
		ПозицияНачалаАбс = ПозицияНачалаАбс + СтрДлина(ТекЧасть) + 1;
		
	КонецЦикла;
	
	Возврат (НедопустимыеСимволы.Количество() = 0);
	
КонецФункции // ИдентификаторЗапросаВалиден()

// Функция - проверяет занятость идентификатора запроса
//
// Параметры:
//   Идентификатор  - Строка                   - проверяемый идентификатор (разделеный ".")
//   ЗапросСсылка   - СправочникСсылка         - элемент справочника для которого проверяется идентификатор
//                    .бир_ЗапросыКДанным
//   ВладелецИд     - СправочникСсылка         - (возвр.) элемент - владелец идентификатора если идентификатор занят
//                    .бир_ЗапросыКДанным
// 
// Возвращаемое значение:
//   Булево         - Истина - идентификатор свободен
//                     Ложь - в противном случае
//
Функция ИдентификаторЗапросаСвободен(Знач Идентификатор, ЗапросСсылка = Неопределено, ВладелецИд = Неопределено) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ЗапросыКДанным.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Справочник.бир_ЗапросыКДанным КАК ЗапросыКДанным
	                      |ГДЕ
	                      |	НЕ ЗапросыКДанным.ЭтоГруппа
	                      |	И ЗапросыКДанным.Ид = &Ид
	                      |	И НЕ ЗапросыКДанным.Ссылка = &Ссылка");
	
	Запрос.УстановитьПараметр("Ид"    , Идентификатор);
	Запрос.УстановитьПараметр("Ссылка", ЗапросСсылка);
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		ВладелецИд = Выборка.Ссылка;
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции // ИдентификаторЗапросаСвободен()

// Функция - выполняет проверки идентификатора запроса на валидность и занятость
// и возвращает результат проверок с описанием возникших ошибок
//
// Параметры:
//   Идентификатор  - Строка                - проверяемый идентификатор (разделеный ".")
//   ЗапросСсылка   - СправочникСсылка      - элемент справочника для которого проверяется идентификатор
//                    .бир_ЗапросыКДанным
// 
// Возвращаемое значение:
//   Структура                                        - результат проверки идентификатора
//     *Свободен               - Булево                 - Истина - идентификатор уникален
//     *Валиден                - Булево                 - Истина - идентификатор не содержит недопустимых символов
//     *Пустой                 - Булево                 - Истина - идентификатор пустой
//     *НедопустимыеСимволы    - Массив из Структура    - массив недопустимых символов с указанием расположения
//     *Ошибки                 - Массив из Строка       - массив описаний найденных ошибок
//
Функция ПроверитьИдентификаторЗапроса(Знач Идентификатор, ЗапросСсылка = Неопределено) Экспорт
	
	Результат = Новый Структура();
	Результат.Вставить("Свободен"           , Истина);
	Результат.Вставить("Валиден"            , Истина);
	Результат.Вставить("Пустой"             , НЕ ЗначениеЗаполнено(Идентификатор));
	Результат.Вставить("Владелец"           , Неопределено);
	Результат.Вставить("НедопустимыеСимволы", Новый Массив());
	Результат.Вставить("Ошибки"             , Новый Массив());
	
	Если Результат.Пустой Тогда
		Результат.Валиден = Ложь;
		Результат.Ошибки.Добавить("Идентификатор не заполнен");
		Возврат Результат;
	КонецЕсли;
	
	Результат.Свободен = ИдентификаторЗапросаСвободен(Идентификатор, ЗапросСсылка, Результат.Владелец);
	Результат.Валиден = ИдентификаторЗапросаВалиден(Идентификатор, Результат.НедопустимыеСимволы);
	
	Если НЕ Результат.Валиден Тогда
		Для Каждого ТекСимвол Из Результат.НедопустимыеСимволы Цикл

			ТекстДо = Лев(Идентификатор, ТекСимвол.ПозицияАбс - 1);
			ТекстПосле = Сред(Идентификатор, ТекСимвол.ПозицияАбс + 1);

			ПредставлениеИд = СтрШаблон("%1~>%2<~%3", ТекстДо, ТекСимвол.Символ, ТекстПосле);
			ТекстСимвол = ?(ТекСимвол.Начальный, "начальный символ", "символ");
			ТекстПозиция = ?(ТекСимвол.Начальный, "", СтрШаблон(" в позиции %1", ТекСимвол.ПозицияАбс));
			ТекстОшибки = "Недопустимый %1 ""%2""%3 в идентификаторе ""%4""!";

			ТекстОшибки = СтрШаблон(ТекстОшибки, ТекстСимвол, ТекСимвол.Символ,	ТекстПозиция, ПредставлениеИд);
			Результат.Ошибки.Добавить(ТекстОшибки);

		КонецЦикла;
	КонецЕсли;

	Если НЕ Результат.Свободен Тогда
		ТекстОшибки = Новый Массив();
		ТекстОшибки.Добавить(СтрШаблон("Идентификатор ""%1"" используется для запроса ", Идентификатор));
		ТекстОшибки.Добавить(Новый ФорматированнаяСтрока(СокрЛП(Результат.Владелец),
		                                                 ,
														 ЦветаСтиля.ГиперссылкаЦвет,
														 ,
														 ПолучитьНавигационнуюСсылку(Результат.Владелец)));
		Результат.Ошибки.Добавить(Новый ФорматированнаяСтрока(ТекстОшибки));
	КонецЕсли;

	Возврат Результат;

КонецФункции // ПроверитьИдентификаторЗапроса()

// Функция - возвращает новый идентификатор запроса
//
// Параметры:
//   Наименование    - Строка                 - наименование запроса
//   ЗапросСсылка    - СправочникСсылка       - элемент справочника для которого проверяется идентификатор
//                     .бир_ЗапросыКДанным
//
// Возвращаемое значение:
//   Строка    - новый идентификатор запроса
//
Функция НовыйИдентификаторЗапроса(Знач Наименование, ЗапросСсылка = Неопределено) Экспорт

	Префикс = ИдентификаторИзСтроки(Наименование);

	Если ИдентификаторЗапросаСвободен(Префикс, ЗапросСсылка) Тогда
		Возврат Префикс;
	КонецЕсли;

	Запрос = Новый Запрос();

	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ЗапросыКДанным.Ид КАК Ид
	               |ИЗ
	               |	Справочник.бир_ЗапросыКДанным КАК ЗапросыКДанным
	               |ГДЕ
	               |	НЕ ЗапросыКДанным.ЭтоГруппа
	               |	И НЕ ЗапросыКДанным.Ссылка = &Запрос
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Ид";

	Запрос.УстановитьПараметр("Запрос", ЗапросСсылка);

	Результат = Запрос.Выполнить();

	Выборка = Результат.Выбрать();

	МаксНомерЗапроса = -1;
	ЗанятыеНомера = Новый Соответствие();
	Пока Выборка.Следующий() Цикл
		Если НЕ Лев(СокрЛП(Выборка.Ид), СтрДлина(Префикс)) = Префикс Тогда
			Продолжить;
		КонецЕсли;

		Суффикс = Сред(СокрЛП(Выборка.Ид), СтрДлина(Префикс) + 1);
		Суффикс = ?(Суффикс = "", 0, Суффикс);
		
		НомерЗапроса = -1;
		Если ОбщегоНазначенияКлиентСервер.ЭтоЧисло(Суффикс) Тогда
			НомерЗапроса = Число(Суффикс);
		КонецЕсли;
		МаксНомерЗапроса = Макс(МаксНомерЗапроса, НомерЗапроса);
		ЗанятыеНомера.Вставить(НомерЗапроса, Истина);
	КонецЦикла;

	НомерЗапроса = МаксНомерЗапроса + 1;
	Для й = 1 По МаксНомерЗапроса Цикл
		Если ЗанятыеНомера.Получить(й) = Неопределено Тогда
			НомерЗапроса = й;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	НомерЗапроса = ?(НомерЗапроса = 0, "", Формат(НомерЗапроса, "ЧДЦ=0; ЧН=; ЧГ="));

	Возврат СтрШаблон("%1%2", Префикс, НомерЗапроса);

КонецФункции // НовыйИдентификаторЗапроса()

// Функция - заменяет в переданной строке недопустимые символы на "_",
// убирает пробелы и переводит символы, следовавшие за пробелом в верхний регистр
//
// Параметры:
//   ИсходнаяСтрока    - Строка    - строка для обработки
//
// Возвращаемое значение:
//   Строка    - преобразованная строка
//
Функция ИдентификаторИзСтроки(Знач ИсходнаяСтрока) Экспорт
  
	ДлинаСтроки = СтрДлина(ИсходнаяСтрока);
	
	ДопустимыеСимволы = ДопустимыеСимволы();
	ДопустимыеНачальныеСимволы = ДопустимыеНачальныеСимволы();
	
	СимволПробела = " ";
	СимволПодчеркивания = "_";
	
	Результат = Новый Массив();
	
	Для й = 1 По ДлинаСтроки Цикл
		ТекСимвол = Сред(ИсходнаяСтрока, й, 1);
		НедопустимыйСимвол = (Результат.Количество() = 0 И ДопустимыеНачальныеСимволы.Получить(ТекСимвол) = Неопределено)
		                  ИЛИ (Результат.Количество() > 0 И ДопустимыеСимволы.Получить(ТекСимвол) = Неопределено);
		ВерхнийРегистр = (Результат.Количество() = 0 ИЛИ Результат[Результат.ВГраница()] = "");
		Если ТекСимвол = СимволПробела Тогда
			Результат.Добавить("");
		ИначеЕсли НедопустимыйСимвол Тогда
			Результат.Добавить(СимволПодчеркивания);
		ИначеЕсли ВерхнийРегистр Тогда
			Результат.Добавить(ВРег(ТекСимвол));
		Иначе
			Результат.Добавить(ТекСимвол);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрСоединить(Результат, "");
	
КонецФункции // ИдентификаторИзСтроки()

#КонецОбласти // СлужебныйПрограммныйИнтерфейс

#Область СлужебныеПроцедурыИФункции

// Функция - возвращает список допустимых символов для идентификаторов
// 
// Возвращаемое значение:
//   Соответствие - список допустимых символов
//
Функция ДопустимыеСимволы()
  
	ДопустимыеСимволы = ДопустимыеНачальныеСимволы();
	
	КодСимвола1 = 48;
	КодСимвола9 = 57;
	Для й = КодСимвола1 По КодСимвола9 Цикл
		ДопустимыеСимволы.Вставить(Символ(й), Истина);
	КонецЦикла;
	
	Возврат ДопустимыеСимволы;
  
КонецФункции // ДопустимыеСимволы()

// Функция - возвращает список допустимых начальных символов для идентификаторов
// 
// Возвращаемое значение:
//   Соответствие - список допустимых символов
//
Функция ДопустимыеНачальныеСимволы()
  
	ДопустимыеСимволы = Новый Соответствие();
	
	ДопустимыеСимволы.Вставить("_", Истина);
	
	КодСимвола_A = 97;
	КодСимвола_z = 122;
	Для й = КодСимвола_A По КодСимвола_z Цикл
		ДопустимыеСимволы.Вставить(Символ(й), Истина);
		ДопустимыеСимволы.Вставить(ВРег(Символ(й)), Истина);
	КонецЦикла;
	
	КодСимвола_А = 1072;
	КодСимвола_я = 1103;
	Для й = КодСимвола_А По КодСимвола_я Цикл
		ДопустимыеСимволы.Вставить(Символ(й), Истина);
		ДопустимыеСимволы.Вставить(ВРег(Символ(й)), Истина);
	КонецЦикла;
	
	ДопустимыеСимволы.Вставить("ё", Истина);
	ДопустимыеСимволы.Вставить("Ё", Истина);
	
	Возврат ДопустимыеСимволы;
  
КонецФункции // ДопустимыеНачальныеСимволы()

#КонецОбласти // СлужебныеПроцедурыИФункции

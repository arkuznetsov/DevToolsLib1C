// Функция - возвращает ссылки и отборы регистров сведений для сохранения
//
// Параметры:
//   ДобавитьСвязанныеДанные    - Булево    - Истина - будут добавлены данные, связанные
//                                            с ссылками из массива "ОтборДанныхДляСохранения"
//
// Возвращаемое значение:
//   Массив Из ЛюбаяСсылка,    - ссылки и отборы регистров сведений
//   Структура
//     *__Тип       - Строка     - строкое описание типа регистра
//                                 (например, РегистрСведенийНаборЗаписей.КурсыВалют)
//     *Отбор       - Структура  - значения измерений регистра для отбора
//                                 (Ключ - имя измерения, Значение - значение измерения)
//
Функция ОтборДанныхДляСохранения(ВключитьСвязанныеДанные = Ложь) Экспорт
	
	Если ВключитьСвязанныеДанные Тогда
		Возврат ОтборДанныхДляСохраненияРасширенный();
	Иначе
		Возврат ОтборДанныхДляСохранения;
	КонецЕсли;
	
КонецФункции // ОтборДанныхДляСохранения() 

// Процедура - устанавливает ссылки и отборы регистров сведений
//
// Параметры:
//   НовыеСсылкиИОтборы    - Массив Из ЛюбаяСсылка    - новый массив объектов для сохранения
//                           Структура
//     *__Тип                - Строка                   - строкое описание типа регистра
//                                                        (например, РегистрСведенийНаборЗаписей.КурсыВалют)
//     *Отбор                - Структура                - значения измерений регистра для отбора
//                                                        (Ключ - имя измерения, Значение - значение измерения)
//
Процедура УстановитьОтборДанныхДляСохранения(Знач НовыеСсылкиИОтборы) Экспорт
	
	ОтборДанныхДляСохранения = Новый Массив();
	ДополнитьОтборДанныхДляСохранения(НовыеСсылкиИОтборы);

КонецПроцедуры // УстановитьОтборДанныхДляСохранения() 

// Процедура - добавляет ссылки и отборы регистров сведений к отбору данных для сохранения
//
// Параметры:
//   ДобавляемыеСсылкиИОтборы    - Массив Из ЛюбаяСсылка, Структура,    - добавляемые объекты для сохранения
//                                 ЛюбаяСсылка, Структура
//     *__Тип                      - Строка                 - строкое описание типа регистра
//                                                            (например, РегистрСведенийНаборЗаписей.КурсыВалют)
//     *Отбор                      - Структура              - значения измерений регистра для отбора
//                                                            (Ключ - имя измерения, Значение - значение измерения)
//
Процедура ДополнитьОтборДанныхДляСохранения(Знач ДобавляемыеСсылкиИОтборы) Экспорт
	
	Если НЕ ТипЗнч(ОтборДанныхДляСохранения) = Тип("Массив") Тогда
		ОтборДанныхДляСохранения = Новый Массив();
	КонецЕсли;
	
	КонтрольныеДанные = Новый Соответствие();
	Для Каждого ТекСсылка Из ОтборДанныхДляСохранения Цикл
		Если ТипЗнч(ТекСсылка) = Тип("Структура") Тогда
			КлючДанных = СтруктураСтрокой(ТекСсылка.Отбор);
		Иначе
			КлючДанных = ТекСсылка;
		КонецЕсли;
		КонтрольныеДанные.Вставить(КлючДанных, Истина);
	КонецЦикла;
	
	ДобавляемыеЗначения = ДобавляемыеСсылкиИОтборы;
	Если НЕ ТипЗнч(ДобавляемыеЗначения) = Тип("Массив") Тогда
		ДобавляемыеЗначения = Новый Массив();
		ДобавляемыеЗначения.Добавить(ДобавляемыеСсылкиИОтборы);
	КонецЕсли;
	
	Для Каждого ТекЗначение Из ДобавляемыеЗначения Цикл
		Если ТипЗнч(ТекЗначение) = Тип("Структура") Тогда
			КлючДанных = СтруктураСтрокой(ТекЗначение.Отбор);
		Иначе
			КлючДанных = ТекЗначение;
		КонецЕсли;
		Если КонтрольныеДанные.Получить(КлючДанных) = Неопределено Тогда
			ОтборДанныхДляСохранения.Добавить(ТекЗначение);
			КонтрольныеДанные.Вставить(КлючДанных, Истина);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры // ДополнитьОтборДанныхДляСохранения() 


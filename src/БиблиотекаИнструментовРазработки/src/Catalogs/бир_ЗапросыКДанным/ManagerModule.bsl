
#Область ПрограммныйИнтерфейс

// Функция - возвращает список всех запросов в справочнике
//
// Параметры:
//   Поля    - Строка                 - список добавляемых в описание полей (строка разделенная "," или массив)
//             Массив из Строка         поля Ид и Наименование возвращаются всегда
//                                      возможные значения: Поля, Параметры, Запрос, Описание
//
// Возвращаемое значение:
//   Массив из Структура                         - список запросов из справочника запросов
//                                                 состав полей указазывается в параметре "Поля"
//     *Ид                 - Строка                - идентификатор запроса
//     *Код                - Строка                - код элемента справочника запросов
//     *Наименование       - Строка                - наименование запроса
//     *Родитель           - СправочникОбъект      - родительская группа справочника запросов
//                           .бир_ЗапросыКДанным
//     *Предопределенный   - Булево                - флаг предопределенного элемента справочника
//     *ПометкаУдаления    - Булево                - пометка удаления
//     *Описание           - Строка                - описание запроса
//     *Запрос             - Строка                - описание запроса в формате JSON
//     *Поля               - Массив из Структура   - описание полей запроса (см. Поля())
//     *Параметры          - Массив из Структура   - описание параметров запроса (см. Параметры())
//
Функция Запросы(Знач Поля = "") Экспорт
	
	Если НЕ ЗначениеЗаполнено(Поля) Тогда
		Поля = Новый Массив();
	КонецЕсли;
	Если ТипЗнч(Поля) = Тип("Строка") Тогда
		Поля = СтрРазделить(Поля, ",", Ложь);
	КонецЕсли;
	Для й = 0 По Поля.ВГраница() Цикл
		Поля[й] = СокрЛП(Поля[й]);
	КонецЦикла;

	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ЗапросыКДанным.Ссылка КАК Ссылка,
	                      |	ЗапросыКДанным.Родитель КАК Родитель,
	                      |	ЗапросыКДанным.Код КАК Код,
	                      |	ЗапросыКДанным.Наименование КАК Наименование,
	                      |	ЗапросыКДанным.Ид КАК Ид,
	                      |	ЗапросыКДанным.Описание КАК Описание,
	                      |	ЗапросыКДанным.Запрос КАК Запрос,
	                      |	ЗапросыКДанным.Предопределенный КАК Предопределенный,
	                      |	ЗапросыКДанным.ПометкаУдаления КАК ПометкаУдаления
	                      |ИЗ
	                      |	Справочник.бир_ЗапросыКДанным КАК ЗапросыКДанным
	                      |ГДЕ
	                      |	НЕ ЗапросыКДанным.ЭтоГруппа
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	Ид");
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	
	Запросы = Новый Массив();

	Пока Выборка.Следующий() Цикл
		
		ОписаниеЗапроса = Новый Структура();
		ОписаниеЗапроса.Вставить("Ид"          , Выборка.Ид);
		ОписаниеЗапроса.Вставить("Наименование", Выборка.Наименование);
		
		Для Каждого ТекПоле Из Поля Цикл
			Если ОписаниеЗапроса.Свойство(ТекПоле) Тогда
				Продолжить;
			КонецЕсли;
			Если Результат.Колонки.Найти(ТекПоле) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ОписаниеЗапроса.Вставить(ТекПоле, Выборка[ТекПоле]);
		КонецЦикла;

		Если НЕ (Поля.Найти("Поля") = Неопределено И Поля.Найти("Параметры") = Неопределено) Тогда
			ЗапросОбъект = Выборка.Ссылка.ПолучитьОбъект();
		КонецЕсли;

		Если НЕ Поля.Найти("Поля") = Неопределено Тогда
			ОписаниеЗапроса.Вставить("Поля", ЗапросОбъект.Поля());
		КонецЕсли;
		Если НЕ Поля.Найти("Параметры") = Неопределено Тогда
			ОписаниеЗапроса.Вставить("Параметры", ЗапросОбъект.Параметры());
		КонецЕсли;

		Запросы.Добавить(ОписаниеЗапроса);
	КонецЦикла;

	Возврат Запросы;

КонецФункции // Запросы()

// Функция - возвращает ссылка на элемент справочника запросов
// или полученный из справочника объект по указанному идентификатору или ссылке
//
// Параметры:
//   Ид        - Строка                 - идентификатор запроса или ссылка на элемент справочника
//               СправочникСсылка
//               .бир_ЗапросыКДанным
//   Объект    - Булево                 - Истина - получить объект справочника запросов
//                                        Ложь - получить ссылку на элемент справочника запросов
//
// Возвращаемое значение:
//   СправочникСсылка        - ссылка на элемент справочника запросов
//   .бир_ЗапросыКДанным       или полученный из справочника объект
//   СправочникОбъект
//   .бир_ЗапросыКДанным
//
Функция Запрос(Ид, Объект = Ложь) Экспорт

	ТипИд = ТипЗнч(Ид);
	Если ТипИд = Тип("СправочникСсылка.бир_ЗапросыКДанным") Тогда
		Запрос = Ид;
	ИначеЕсли ТипИд = Тип("Строка") Тогда
		Запрос = Справочники.бир_ЗапросыКДанным.НайтиПоРеквизиту("Ид", Ид);
	Иначе
		ТекстОшибки = СтрШаблон("Некорректный тип ""%1"" идентификатора запроса ""%2""!
		                        |Ожидается ""Строка"" или ""СправочникСсылка.бир_ЗапросыКДанным"".",
		                        ТипИд,
		                        Ид);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;

	Если Запрос.Пустая() Тогда
		ТекстОшибки = СтрШаблон("Не найден запрос по идентификатору ""%1""!", Ид);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;

	Если Объект Тогда
		Попытка
			Запрос = Запрос.ПолучитьОбъект();
		Исключение
			ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ТекстОшибки = СтрШаблон("Ошибка получения объекта запроса ""%1"":%2%3!",
			                        Запрос,
			                        Символы.ПС,
			                        ТекстОшибки);
			ВызватьИсключение ТекстОшибки;
		КонецПопытки;
	КонецЕсли;
	
	Возврат Запрос;

КонецФункции // Запрос()

// Функция - возвращает обработку-процессор запросов
//
// Параметры:
//   Ид           - Строка,               - идентификатор запроса или ссылка на элемент справочника
//                  СправочникСсылка
//                  .бир_ЗапросыКДанным
//   ПоУмолчанию  - Булево                - Истина - получить процессор запросов со значениями параметров по умолчанию;
//                                          Ложь - получить ранее инициализированный процессор запросов
//
// Возвращаемое значение:
//   ОбработкаОбъект           - обработка-процессор запросов
//   .бир_ПроцессорЗапросов
//
Функция ПроцессорЗапросов(Ид, ПоУмолчанию = Ложь) Экспорт

	Запрос = Запрос(Ид, Истина);
	Попытка
		ПроцессорЗапросов = Запрос.ПроцессорЗапросов();
	Исключение
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ТекстОшибки = СтрШаблон("Ошибка получения процессора запросов для запроса ""%1"":%2%3!",
		                        Запрос.Ссылка,
		                        Символы.ПС,
		                        ТекстОшибки);
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;

	Возврат ПроцессорЗапросов;

КонецФункции // ПроцессорЗапросов()

// Функция - возвращает описание указанного объекта запроса
//
// Параметры:
//   Ид      - Строка                 - идентификатор запроса или ссылка на элемент справочника
//             СправочникСсылка
//             .бир_ЗапросыКДанным
//   Поля    - Строка                 - список добавляемых в описание полей (строка разделенная "," или массив)
//             Массив из Строка         поля Ид и Наименование возвращаются всегда
//                                      возможные поля: Поля, Параметры, Описание
//
// Возвращаемое значение:
//   Массив из Структура                         - описание указанного объекта запроса
//                                                 состав полей указазывается в параметре "Поля"
//     *Ид                 - Строка                - идентификатор запроса
//     *Код                - Строка                - код элемента справочника запросов
//     *Наименование       - Строка                - наименование запроса
//     *Родитель           - СправочникОбъект      - родительская группа справочника запросов
//                           .бир_ЗапросыКДанным
//     *Предопределенный   - Булево                - флаг предопределенного элемента справочника
//     *ПометкаУдаления    - Булево                - пометка удаления
//     *Описание           - Строка                - описание запроса
//     *ТекстЗапроса       - Строка                - текст запроса
//     *Поля               - Массив из Структура   - описание полей запроса (см. ПоляЗапроса())
//     *Параметры          - Массив из Структура   - описание параметров запроса (см. ПараметрыЗапроса())
//
Функция ОписаниеЗапроса(Ид, Знач Поля = "") Экспорт
	
	Запрос = Запрос(Ид, Истина);
	
	Возврат Запрос.Описание(Поля);

КонецФункции // ОписаниеЗапроса()

// Функция - возвращает поля запроса, возвращающего данные для указанного объекта запроса
//
// Параметры:
//   Ид                  - Строка                - идентификатор запроса или ссылка на элемент справочника
//                         СправочникСсылка
//                         .бир_ЗапросыКДанным
//   НомерЗапросаПакета  - Число                 - номер запроса в пакете, для которого требуется получить поля
//                                                 если не указано, то возвращаются поля последнего запроса
//                                                 используется сквозная нумерация запросов в пакете
//                                                 с учетом запросов на создание/уничтожение временных таблиц
//
// Возвращаемое значение:
//   Массив из Структура                          - параметры запроса для текущего объекта запроса
//     *Имя                      - Строка           - псевдоним поля в запросе
//     *ИспользоватьРеквизиты    - Булево           - Истина - для поля указано разыменование через ".*"
//     *ТипЗначения              - ОписаниеТипов    - тип значения поля если удалось вычислить
//
Функция ПоляЗапроса(Ид, НомерЗапросаПакета = Неопределено) Экспорт

	Запрос = Запрос(Ид, Истина);
	
	Возврат Запрос.Поля(НомерЗапросаПакета);

КонецФункции // ПоляЗапроса()

// Функция - возвращает параметры запроса для указанного объекта запроса
//
// Параметры:
//   Ид                   - СтрокаНомерЗапросаПакета    - идентификатор запроса или ссылка на элемент справочника
//                          СправочникСсылка
//                         .бир_ЗапросыКДанным
//   ЗаполнитьЗначения    - Булево                      - Истина - вычислить значения параметров
//
// Возвращаемое значение:
//   Массив из Структура                - параметры запроса для указанного объекта запроса
//     *Имя            - Строка           - имя параметра
//     *ТипЗначения    - ОписаниеТипов    - тип значения параметра
//
Функция ПараметрыЗапроса(Ид, ЗаполнитьЗначения = Ложь) Экспорт

	Запрос = Запрос(Ид, Истина);
	
	Возврат Запрос.Параметры(ЗаполнитьЗначения);

КонецФункции // ПараметрыЗапроса()


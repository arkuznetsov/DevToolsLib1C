    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	СобытияОбработка.ТочкаВозникновения,
	СобытияОбработка.Ид,
	СобытияОбработка.Обработчик,
	СобытияОбработка.Событие,
	СобытияОбработка.РучнаяОбработка,
	СобытияОбработка.Обработано,
	СобытияОбработка.Ошибка,
	СобытияОбработка.РезультатОбработки,
	События.Дата,
	События.Момент,
	События.Источник,
	События.Пользователь
ИЗ
	РегистрСведений.бир_СобытияОбработка КАК СобытияОбработка
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бир_События КАК События
		ПО СобытияОбработка.ТочкаВозникновения = События.ТочкаВозникновения
			И СобытияОбработка.Ид = События.Ид</queryText>
      <mainTable>InformationRegister.бир_События</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>

#Область ОписаниеПеременных

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьСписокСтилей();
	
	ОбновитьРасширений();

	ОбновитьСписокРегламентныхЗаданий();

КонецПроцедуры // ПриСозданииНаСервере()

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЗаполнитьСтили();
	
	ОтобразитьЦветаГлавногоСтиля();
	
	УстановитьДоступностьЭлементов();

КонецПроцедуры // ПриОткрытии()

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)

	Если НЕ ЭтаФорма.Модифицированность Тогда
		Возврат;
	КонецЕсли;

	Если бир_РасположениеИБВызовСервера.ГлавныйСтильИзменен(Объект.Ссылка, Объект.ГлавныйСтиль) Тогда
		ПараметрыЗаписи.Вставить("ПредложитьПерезапуск", Истина);
		ПараметрыЗаписи.Вставить("ТекущийГлавныйСтиль",
		                         бир_РасположениеИБВызовСервера.ГлавныйСтильРасположенияИБ(Объект.Ссылка));
		ПараметрыЗаписи.Вставить("НовыйГлавныйСтиль",
		                         Элементы.ГлавныйСтиль.СписокВыбора.НайтиПоЗначению(Объект.ГлавныйСтиль).Представление);
	КонецЕсли;

КонецПроцедуры // ПередЗаписью()

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ТекущийОбъект.НастройкаРегламентныхЗаданий.Очистить();
	
	ТабЗаданий = РеквизитФормыВЗначение("НастройкаРегламентныхЗаданий");
	Для Каждого ТекСтрока Из ТабЗаданий Цикл
		Если ТекСтрока.Действие = 2 Тогда
			Продолжить;
		КонецЕсли;
		НовоеЗадание = ТекущийОбъект.НастройкаРегламентныхЗаданий.Добавить();
		НовоеЗадание.Задание  = ТекСтрока.Имя;
		НовоеЗадание.Действие = (ТекСтрока.Действие = 1);
	КонецЦикла;
	
	ТекущийОбъект.НастройкаРасширений.Очистить();
	
	ТабРасширений = РеквизитФормыВЗначение("НастройкаРасширений");
	Для Каждого ТекСтрока Из ТабРасширений Цикл
		Если ТекСтрока.Активность = 2
		   И ТекСтрока.БезопасныйРежим = 2
		   И ТекСтрока.ЗащитаОтОпасныхДействий = 2 Тогда
			Продолжить;
		КонецЕсли;
		НовоеРасширение = ТекущийОбъект.НастройкаРасширений.Добавить();
		НовоеРасширение.Расширение              = ТекСтрока.Имя;
		НовоеРасширение.Активность              = (ТекСтрока.Активность = 1);
		НовоеРасширение.БезопасныйРежим         = (ТекСтрока.БезопасныйРежим = 1);
		НовоеРасширение.ЗащитаОтОпасныхДействий = (ТекСтрока.ЗащитаОтОпасныхДействий = 1);
	КонецЦикла;
	
КонецПроцедуры // ПередЗаписьюНаСервере()

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ПредложитьПерезапуск = Ложь;
	Если НЕ ПараметрыЗаписи.Свойство("ПредложитьПерезапуск", ПредложитьПерезапуск) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ПредложитьПерезапуск Тогда
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = СтрШаблон("Изменен стиль для текущего расположения ИБ (""%1"" -> ""%2"").
	                         |Изменения вступят в силу после перезапуска.
							 |
							 |Перезапустить приложение?", ПараметрыЗаписи.ТекущийГлавныйСтиль, ПараметрыЗаписи.НовыйГлавныйСтиль);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПерезапуститьПриложение", ЭтаФорма);
	
	ПоказатьВопрос(ОписаниеОповещения,
	               ТекстВопроса,
				   РежимДиалогаВопрос.ДаНет,
				   20,
				   КодВозвратаДиалога.Нет,
				   "Перезапуск приложения",
				   КодВозвратаДиалога.Нет);
	
КонецПроцедуры // ПослеЗаписи()

